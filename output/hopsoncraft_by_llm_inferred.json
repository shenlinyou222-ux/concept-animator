        {
          "id": "fchunk",
          "name": "Full_Chunk",
          "summary": "高度方向的索引函数。",
          "explanation": [],
          "is_primitive": true,
          "primitive_kind": "math",
          "contrast": [],
          "blocks": [
            {
              "type": "formula",
              "text": "Full_Chunk(c) = ⟨Section(c,v)⟩_{v=0..H−1}",
              "caption": "c=(cx,cz)；高度维被此层吸收，Map 才只需 ℤ² 键",
              "symbols": [
                {
                  "sym": "c",
                  "kind": "向量（整数对）",
                  "meaning": "水平坐标 (cx,cz) ∈ ℤ²"
                },
                {
                  "sym": "v",
                  "kind": "标量（序号）",
                  "meaning": "垂直方向第 v 段，v ∈ [0,H)"
                },
                {
                  "sym": "H",
                  "kind": "常数",
                  "meaning": "世界高度的 Section 段数"
                },
                {
                  "sym": "⟨·⟩",
                  "kind": "序列构造",
                  "meaning": "按 v 排列的 Section 序列"
                }
              ]
            }
          ],
          "set_relations": [],
          "temporal_relations": [],
          "spatial_relations": [],
          "children": []
        },
        {
          "id": "map",
          "name": "Map 哈希表",
          "summary": "无限平面的按需加载：开放寻址哈希表三件套。",
          "explanation": [
            "Map 必须拆到 (h, A, α) 三件套才允许终止。",
            "键是 ℤ² 水平坐标，因为高度已被 Full_Chunk 吸收。"
          ],
          "is_primitive": false,
          "primitive_kind": null,
          "contrast": [],
          "blocks": [
            {
              "type": "formula",
              "text": "插入: Aₜ₊₁ = Aₜ[i ↦ c], nₜ₊₁ = nₜ+1,  i = h(c) ∨ probe(Aₜ, i)",
              "caption": "哈希表状态方程：probe 沿冲突序列找空位",
              "symbols": [
                {
                  "sym": "Aₜ",
                  "kind": "数组（定长）",
                  "meaning": "桶数组，长 m"
                },
                {
                  "sym": "i ↦ c",
                  "kind": "单点写入",
                  "meaning": "桶 i 放入 chunk 引用 c"
                },
                {
                  "sym": "nₜ",
                  "kind": "标量（计数）",
                  "meaning": "已用桶数 +1"
                },
                {
                  "sym": "probe",
                  "kind": "函数",
                  "meaning": "冲突时沿序列找空位"
                }
              ]
            },
            {
              "type": "formula",
              "text": "Map = (h, A), h: ℤ² → ℤ_m, A: [m] → Full_Chunk ∪ {⊥}",
              "caption": "⊥ = 未加载；命中 = 已加载",
              "symbols": [
                {
                  "sym": "h",
                  "kind": "函数",
                  "meaning": "哈希函数 ℤ² → ℤ_m（多对一）"
                },
                {
                  "sym": "A",
                  "kind": "数组",
                  "meaning": "桶数组 [m] → Full_Chunk ∪ {⊥}"
                },
                {
                  "sym": "⊥",
                  "kind": "空值标记",
                  "meaning": "该桶未加载"
                }
              ]
            },
            {
              "type": "video",
              "src": "media/videos/manim_scene2/480p15/HashProbe.mp4",
              "caption": "Manim：哈希定位与冲突探测"
            },
            {
              "type": "quiz",
              "question": "为什么键是 ℤ² 不是 ℤ³？",
              "hint": "值是什么",
              "answer": "值是 Full_Chunk（整列 Section），高度维已在值里，键只需水平坐标。"
            }
          ],
          "set_relations": [],
          "temporal_relations": [],
          "spatial_relations": [],
          "children": [
            {
              "id": "hash",
              "name": "哈希函数 h",
              "summary": "无限平面压进有限桶域的多对一映射。",
              "explanation": [],
              "is_primitive": true,
              "primitive_kind": "math",
              "contrast": [],
              "blocks": [
                {
                  "type": "formula",
                  "text": "h(cx,cz)=(a·cx+b·cz) mod m, a,b,m 两两素",
                  "caption": "O(1)；鸽笼原理 ⟹ 冲突必然存在",
                  "symbols": [
                    {
                      "sym": "a, b",
                      "kind": "常数（整数）",
                      "meaning": "与 m 两两素，保证分布均匀"
                    },
                    {
                      "sym": "mod m",
                      "kind": "取模运算",
                      "meaning": "压进桶域 [0,m)"
                    }
                  ]
                }
              ],
              "set_relations": [],
              "temporal_relations": [],
              "spatial_relations": [],
              "children": []
            },
            {
              "id": "bucket",
              "name": "桶数组 A",
              "summary": "长度 m=2^k 的连续数组。",
              "explanation": [],
              "is_primitive": true,
              "primitive_kind": "math",
              "contrast": [],
              "blocks": [
                {
                  "type": "formula",
                  "text": "A: [m] → Full_Chunk ∪ {⊥};  i mod m = i ∧ (m−1)",
