      "children": [
        {
          "id": "section",
          "name": "Section = (C, L)",
          "summary": "16³ 体素段：方块张量与光照张量的有序对。",
          "explanation": [
            "数学定义：Section = (C, L)，C,L ∈ T := {0..255}^[16]³。",
            "双张量分离的原因：写主体不同——C 由生成/交互写，L 由光照传播独立更新。"
          ],
          "is_primitive": true,
          "primitive_kind": "math",
          "contrast": [],
          "blocks": [
            {
              "type": "formula",
              "text": "Section = (C, L),  C,L ∈ T = 𝔹₈⁴⁰⁹⁶, |T| = 256⁴⁰⁹⁶",
              "caption": "双张量有序对；单段状态空间上界",
              "symbols": [
                {
                  "sym": "(C, L)",
                  "kind": "有序对（双张量）",
                  "meaning": "方块态与光照态，同形 [16]³"
                },
                {
                  "sym": "T = 𝔹₈⁴⁰⁹⁶",
                  "kind": "张量空间",
                  "meaning": "4096 字节全部可能取值"
                },
                {
                  "sym": "|T| = 256⁴⁰⁹⁶",
                  "kind": "标量（基数）",
                  "meaning": "单段状态空间大小（≈10⁹⁸⁶⁸）"
                }
              ]
            },
            {
              "type": "video",
              "src": "media/videos/manim_scene/480p15/SectionSigma.mp4",
              "caption": "Manim：σ 双射——坐标现场计算，不占存储"
            },
            {
              "type": "quiz",
              "question": "点/坐标占多少存储？",
              "hint": "σ⁻¹ 现场反解",
              "answer": "零。坐标由 σ⁻¹(i)=(i mod 16, (i÷16) mod 16, i÷256) 现场算出；唯一存储是每格 1 字节的值（4KB）。稠密税：空气也交 1 字节，换 O(1) 无分支寻址。"
            },
            {
              "type": "formula",
              "text": "Lₜ₊₁(p) = max(Lₜ(p), max_{q∈N₆(p)} Lₜ(q) − 1),  L* = limₜ→∞ Lₜ",
              "caption": "光照传播=逐点松弛到不动点：每格向邻居借光再衰减1——BFS 单调收敛，天然 kernel 化",
              "symbols": [
                {
                  "sym": "Lₜ(p)",
                  "kind": "标量（0..15）",
                  "meaning": "格 p 在第 t 轮传播的光强"
                },
                {
                  "sym": "N₆(p)",
                  "kind": "集合",
                  "meaning": "p 的 6 个面邻居坐标"
                },
                {
                  "sym": "− 1",
                  "kind": "常数衰减",
                  "meaning": "每传一格光强减 1"
                },
                {
                  "sym": "L*",
                  "kind": "不动点",
                  "meaning": "迭代收敛的终态光照（存在且唯一：单调有界）"
                }
              ]
            }
          ],
          "set_relations": [],
          "temporal_relations": [],
          "spatial_relations": [],
          "children": [
            {
              "id": "idx",
              "name": "索引双射 σ",
              "summary": "行主序三维→一维压缩。",
              "explanation": [],
              "is_primitive": true,
              "primitive_kind": "math",
              "contrast": [],
              "blocks": [
                {
                  "type": "formula",
                  "text": "σ(x,y,z)=x+16(y+16z),  σ(3,7,12)=3187",
                  "caption": "乘加双射，无除法无冲突；GPU 同布局零转换",
                  "symbols": [
                    {
                      "sym": "σ",
                      "kind": "双射",
                      "meaning": "三维坐标 ↔ 一维偏移，可逆无冲突"
                    },
                    {
                      "sym": "x,y,z",
                      "kind": "标量（整数）",
                      "meaning": "格子在段内的坐标，各 ∈ [0,16)"
                    },
                    {
                      "sym": "3187",
                      "kind": "标量（偏移）",
                      "meaning": "σ(3,7,12) 的值：内存中的字节位置"
                    }
                  ]
                },
                {
                  "type": "callout",
                  "text": "『布局不变』是 NARP 映射的前提：GPU 侧沿用同一 σ。",
                  "tone": "key"
                }
              ],
              "set_relations": [],
