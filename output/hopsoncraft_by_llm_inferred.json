    {
      "id": "terrain",
      "name": "Terrain_Generator",
      "summary": "噪声+biome+树生成地形；mutex 强制串行是痛点。",
      "explanation": [
        "地形 = 噪声场的函数：terrain = f(noise, biome, tree)。",
        "mutex 使任意时刻只有一个 chunk 在生成——多核也白搭。"
      ],
      "is_primitive": false,
      "primitive_kind": null,
      "contrast": [],
      "blocks": [
        {
          "type": "formula",
          "text": "C₀|ₙₑw = terrain(ℤ³) := g(noise(p), biome),  ΔS = S ⊎ (c ↦ C₀|ₙₑw)",
          "caption": "生成=对新 chunk 的初始化方程：从空(⊥)到确定初值",
          "symbols": [
            {
              "sym": "C₀|ₙₑw",
              "kind": "张量",
              "meaning": "新 chunk 的初始方块态"
            },
            {
              "sym": "g",
              "kind": "复合函数",
              "meaning": "噪声→biome→树 的逐点生成函数"
            },
            {
              "sym": "noise(p)",
              "kind": "标量场",
              "meaning": "确定性伪随机值 ∈ [−1,1]"
            },
            {
              "sym": "biome(cx,cz)",
              "kind": "查表函数",
              "meaning": "按水平坐标取生态参数"
            },
            {
              "sym": "⊎",
              "kind": "二元算子",
              "meaning": "把新段并入全局状态（⊥→值）"
            }
          ]
        },
        {
          "type": "formula",
          "text": "terrain: ℤ³ → 𝔹₈,  terrain(p) = g(noise(p), biome(cx,cz))",
          "caption": "确定性：同输入必同输出（与整数 DDA 同一铁律）",
          "symbols": [
            {
              "sym": "ℤ³",
              "kind": "定义域",
              "meaning": "三维整数坐标（格心）"
            },
            {
              "sym": "𝔹₈",
              "kind": "值域",
              "meaning": "8 位方块编号"
            },
            {
              "sym": "noise / biome",
              "kind": "函数",
              "meaning": "见子节点定义"
            }
          ]
        },
        {
          "type": "callout",
          "text": "痛点数字①：mutex 串行生成。GPU 噪声 kernel 并行直写 chunk 张量后消失。",
          "tone": "warn"
        },
